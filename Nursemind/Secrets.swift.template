import Foundation

// Setup: copy this file to Secrets.swift and fill in the key.
// Secrets.swift is gitignored; the template is committed.
//
// For production: API keys must NEVER ship in the iOS bundle.
// Move to a server-side proxy (Supabase Edge Function) before TestFlight.

enum Secrets {
    // Isolated Meta app for development builds; blank values disable test events.
    static let metaSandboxAppID: String = ""
    static let metaSandboxClientToken: String = ""
    // Public SDK identifiers only. Never put a Meta App Secret or CAPI token here.
    static let metaAppID: String = ""
    static let metaClientToken: String = ""
    static let anthropicAPIKey: String? = {
        #if DEBUG
        return "sk-ant-api03-..."   // ← paste your dev key here
        #else
        return nil
        #endif
    }()

    // TikTok Business SDK — leave empty strings to disable.
    static let tiktokAppID: String = ""           // TikTok internal app ID
    static let tiktokAppleAppID: String = ""      // App Store numeric ID
    static let tiktokAccessToken: String = ""     // Events API token
}
